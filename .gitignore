# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# app data (SQLite transcripts) — never commit game history or keys
/data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# audio sourcing tool. The picked audio, the manifest, the credits and the
# config that produced them are tracked: they ship with the game, and a deploy
# hard-resets the checkout, so anything untracked would not survive one. The
# build artefacts are ignored — `candidates.json` is a search dump and
# `picker.html` is generated from it, both re-made by one `harvest`; the
# catalogue database below is the third.
/audio/candidates.json
/audio/picker.html

# The incompetech catalogue database. Derived: one command rebuilds it (two
# requests — the catalogue JSON and the page its lookup tables are checked
# against), and it is a dev-tool artefact rather than part of the pack the
# runtime serves, so it is not committed — vendoring someone else's 1442-row
# catalogue into git would only go stale and churn. (`*.sqlite3` above already
# catches it; it is named here so the reason is written down.)
/audio/incompetech.sqlite3
/audio/incompetech.json

# logs / local
*.log
.env
.DS_Store
